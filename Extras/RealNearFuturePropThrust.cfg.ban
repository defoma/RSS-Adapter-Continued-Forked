// ---- Pulsed inductive thrusters (argon) ------------------------------------
// PIT Mk V physics: eta 0.5, so thrust = 2 x 0.5 x P / (g0 x 4,000 s) at the low-power end; doubling power doubles Isp.

@PART[pit-0625]:NEEDS[NearFuturePropulsion]:FINAL // PIT Mk V at 5-10 Hz: 0.51 N, 20-40 kW
{
	@MODULE[ModuleEnginesFX]
	{
		@maxThrust = 0.00051
		@PROPELLANT[ElectricCharge] { @ratio = 2745.09 }
	}
	@MODULE[VariablePowerEngine]
	{
		@ConstantThrust = 0.00051
		@PowerCurve
		{
			@key,0 = 0 20
			@key,1 = 1 40
		}
	}
}

@PART[pit-125]:NEEDS[NearFuturePropulsion]:FINAL // PIT Mk V class at 12.5-25 Hz: 1.27 N, 50-100 kW
{
	@MODULE[ModuleEnginesFX]
	{
		@maxThrust = 0.0012746
		@PROPELLANT[ElectricCharge] { @ratio = 2745.09 }
	}
	@MODULE[VariablePowerEngine]
	{
		@ConstantThrust = 0.0012746
		@PowerCurve
		{
			@key,0 = 0 50
			@key,1 = 1 100
		}
	}
}

@PART[pit-25]:NEEDS[NearFuturePropulsion]:FINAL // PIT Mk V class at 25-50 Hz: 2.55 N, 100-200 kW
{
	@MODULE[ModuleEnginesFX]
	{
		@maxThrust = 0.0025493
		@PROPELLANT[ElectricCharge] { @ratio = 2745.09 }
	}
	@MODULE[VariablePowerEngine]
	{
		@ConstantThrust = 0.0025493
		@PowerCurve
		{
			@key,0 = 0 100
			@key,1 = 1 200
		}
	}
}

// ---- VASIMR (argon / xenon) ------------------------------------------------
// VX-200 thrust per power (5.7 N at 200 kW, 5,000 s). Every thrust key is scaled by the same factor, so the
// Isp/thrust trade and the xenon mode keep NFP's shape.

@PART[vasimr-0625]:NEEDS[NearFuturePropulsion]:FINAL // one VF-200 core: 2.85 N, 100 kW
{
	@MODULE[ModuleEnginesFX]:HAS[#engineID[ArgonMode]]
	{
		@maxThrust *= 0.000776567
		@PROPELLANT[ElectricCharge] { @ratio = 3069.30 }
	}
	@MODULE[ModuleEnginesFX]:HAS[#engineID[XenonMode]]
	{
		@maxThrust *= 0.000776567
		@PROPELLANT[ElectricCharge] { @ratio = 67675.1 }
	}
	@MODULE[VariableISPEngine]
	{
		@EnergyUsage = 100
		@VARIABLEISPMODE[*],*
		{
			@IspThrustCurve { @key,*[1, ] *= 0.000776567 }
		}
	}
}

@PART[vasimr-125]:NEEDS[NearFuturePropulsion]:FINAL // VF-200: 5.7 N, 200 kW
{
	@MODULE[ModuleEnginesFX]:HAS[#engineID[ArgonMode]]
	{
		@maxThrust *= 0.000387755
		@PROPELLANT[ElectricCharge] { @ratio = 3069.31 }
	}
	@MODULE[ModuleEnginesFX]:HAS[#engineID[XenonMode]]
	{
		@maxThrust *= 0.000387755
		@PROPELLANT[ElectricCharge] { @ratio = 67713.0 }
	}
	@MODULE[VariableISPEngine]
	{
		@EnergyUsage = 200
		@VARIABLEISPMODE[*],*
		{
			@IspThrustCurve { @key,*[1, ] *= 0.000387755 }
		}
	}
}

@PART[vasimr-25]:NEEDS[NearFuturePropulsion]:FINAL // 2 MW VASIMR: 57 N
{
	@MODULE[ModuleEnginesFX]:HAS[#engineID[ArgonMode]]
	{
		@maxThrust *= 0.000775510
		@PROPELLANT[ElectricCharge] { @ratio = 3069.31 }
