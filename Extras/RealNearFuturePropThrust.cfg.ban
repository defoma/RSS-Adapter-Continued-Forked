		@PROPELLANT[ElectricCharge] { @ratio = 67740.3 }
	}
	@MODULE[VariableISPEngine]
	{
		@EnergyUsage = 2000
		@VARIABLEISPMODE[*],*
		{
			@IspThrustCurve { @key,*[1, ] *= 0.000775510 }
		}
	}
}

