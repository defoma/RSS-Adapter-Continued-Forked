//Changes the NFP ion engines to a realistic but painfully slow but realistic value

// ---- Hall thrusters (argon) ------------------------------------------------

@PART[ionArgon-0625]:NEEDS[NearFuturePropulsion]:FINAL // Starlink V2 Mini: 170 mN, 4.2 kW
{
	@MODULE[ModuleEnginesFX]
	{
		@maxThrust = 0.00017
		@PROPELLANT[ElectricCharge] { @ratio = 1080.58 }
	}
}

