@PART[SEE_FEEP_engine]:NEEDS[SupplementaryElectricEngines]:FINAL // FEEP-50: 1.4 mN; ~56 W (est., Alta FT-150's 40 W/mN)
{
	@MODULE[ModuleEngines*]
	{
		@maxThrust = 0.0000014
		@PROPELLANT[ElectricCharge] { @ratio = 581.82 }
	}
}

// ---- Caesium at real FEEP loads ---------------------------------------------
// Real FEEPs carry grams to a few kilograms of caesium, mostly in a reservoir built into the thruster.
// The FEEP gets a 0.25 kg reservoir (est., like the 230 g built into Enpulsion's IFM Nano FEEP).
// The tanks keep their full rescaled capacity (maxAmount) but start with 1 kg (est.); add more in the VAB
// with the slider if a mission needs it.

@PART[SEE_FEEP_engine]:NEEDS[SupplementaryElectricEngines]:FINAL // 0.25 kg = 0.1295 L of caesium
{
	RESOURCE
	{
		name = Caesium
		amount = 0.1295
		maxAmount = 0.1295
	}
}

@PART[see_indiumTank_0625|see_indiumTank_125|see_indiumTank_radial]:NEEDS[SupplementaryElectricEngines]:FINAL // start with 1 kg = 0.518 L
{
	@RESOURCE[Caesium] { @amount = 0.518 }
}
