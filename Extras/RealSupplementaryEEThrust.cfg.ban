//Changes the default ion engine thrust to be realistic but painfully slow

@PART[rj_engine_small]:NEEDS[SupplementaryElectricEngines]:FINAL // MR-501B: 0.37 N, 493 W
{
	@MODULE[ModuleEngines*]
	{
		@maxThrust = 0.00037
		@PROPELLANT[ElectricCharge] { @ratio = 1998.65 }
	}
}

@PART[rj_engine_big]:NEEDS[SupplementaryElectricEngines]:FINAL // MR-502A: 0.80 N, 885 W
{
	@MODULE[ModuleEngines*]
	{
		@maxThrust = 0.0008
		@PROPELLANT[ElectricCharge] { @ratio = 1777.9 }
	}
}

@PART[SEE_rj_rcs]:NEEDS[SupplementaryElectricEngines]:FINAL // MR-501B per nozzle: 0.37 N, 493 W
{
	@MODULE[ModuleRCSFX]
	{
		@thrusterPower = 0.00037
		@PROPELLANT[ElectricCharge] { @ratio = 1998.65 }
	}
}

