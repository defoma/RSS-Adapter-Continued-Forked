<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <AssemblyName>FreeIvaSeatScaleFix</AssemblyName>
    <RootNamespace>FreeIvaSeatScaleFix</RootNamespace>
    <Version>1.0.0</Version>
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
    <KSPBT_ModRoot>$(MSBuildThisFileDirectory)GameData/FreeIvaSeatScaleFix</KSPBT_ModRoot>
    <KSPBT_ModPluginFolder>Plugins</KSPBT_ModPluginFolder>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="KSPBuildTools" Version="1.1.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- HarmonyKSP is the name Harmony registers with KSP's assembly loader, not 0Harmony. -->
    <ModReference Include="0Harmony">
      <DLLPath>GameData/000_Harmony/0Harmony.dll</DLLPath>
      <CKANIdentifier>Harmony2</CKANIdentifier>
      <KSPAssemblyName>HarmonyKSP</KSPAssemblyName>
      <KSPAssemblyVersion>1.0</KSPAssemblyVersion>
    </ModReference>
  </ItemGroup>

  <ItemGroup>
    <KSPVersionFile Include=".">
      <Destination>$(KSPBT_ModRoot)/FreeIvaSeatScaleFix.version</Destination>
      <KSP_Version_Min>1.12.0</KSP_Version_Min>
      <KSP_Version_Max>1.12.99</KSP_Version_Max>
      <KSP_Version>1.12.5</KSP_Version>
    </KSPVersionFile>
  </ItemGroup>
</Project>
